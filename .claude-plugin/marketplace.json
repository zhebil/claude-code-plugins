{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "zhebil-tools",
  "description": "Claude Code plugins for developer productivity.",
  "owner": {
    "name": "Zhebil"
  },
  "plugins": [
    {
      "name": "unfurl-context",
      "description": "Unfurls Jira, GitHub, GitLab, and Sentry links in your prompt into context Claude can read.",
      "author": {
        "name": "Zhebil"
      },
      "homepage": "https://github.com/zhebil/claude-code-plugins/tree/main/plugins/unfurl-context",
      "repository": "https://github.com/zhebil/claude-code-plugins",
      "license": "MIT",
      "category": "productivity",
      "tags": [
        "unfurl",
        "jira",
        "github",
        "gitlab",
        "sentry",
        "hooks",
        "context",
        "claude-code-plugin"
      ],
      "source": "./plugins/unfurl-context"
    },
    {
      "name": "mermaid-view",
      "description": "Draws Mermaid diagrams in Claude's replies as Unicode box art in the terminal, laid out by ELK to fit its width.",
      "author": {
        "name": "Zhebil"
      },
      "homepage": "https://github.com/zhebil/claude-code-plugins/tree/main/plugins/mermaid-view",
      "repository": "https://github.com/zhebil/claude-code-plugins",
      "license": "MIT",
      "category": "productivity",
      "tags": [
        "mod",
        "mermaid",
        "diagrams",
        "terminal",
        "claude-code-plugin"
      ],
      "source": "./plugins/mermaid-view"
    },
    {
      "name": "zed-open",
      "description": "Adds a /zed command that opens the session's directory, or a path in it, in Zed.",
      "author": {
        "name": "Zhebil"
      },
      "homepage": "https://github.com/zhebil/claude-code-plugins/tree/main/plugins/zed-open",
      "repository": "https://github.com/zhebil/claude-code-plugins",
      "license": "MIT",
      "category": "productivity",
      "tags": [
        "mod",
        "zed",
        "editor",
        "command",
        "claude-code-plugin"
      ],
      "source": "./plugins/zed-open"
    },
    {
      "name": "cmux-fork",
      "description": "Adds a /fork-new command that forks the session into a new cmux tab.",
      "author": {
        "name": "Zhebil"
      },
      "homepage": "https://github.com/zhebil/claude-code-plugins/tree/main/plugins/cmux-fork",
      "repository": "https://github.com/zhebil/claude-code-plugins",
      "license": "MIT",
      "category": "productivity",
      "tags": [
        "mod",
        "cmux",
        "fork",
        "session",
        "command",
        "claude-code-plugin"
      ],
      "source": "./plugins/cmux-fork"
    }
  ]
}
