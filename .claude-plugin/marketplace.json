{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "zhebil-tools",
  "description": "Claude Code plugins for developer productivity.",
  "owner": {
    "name": "Zhebil"
  },
  "plugins": [
    {
      "name": "unfurl-context",
      "description": "Unfurls Jira, GitHub, GitLab, and Sentry links in your prompt into context Claude can read.",
      "author": {
        "name": "Zhebil"
      },
      "homepage": "https://github.com/zhebil/claude-code-plugins/tree/main/plugins/unfurl-context",
      "repository": "https://github.com/zhebil/claude-code-plugins",
      "license": "MIT",
      "category": "productivity",
      "tags": [
        "unfurl",
        "jira",
        "github",
        "gitlab",
        "sentry",
        "hooks",
        "context",
        "claude-code-plugin"
      ],
      "source": "./plugins/unfurl-context"
    },
    {
      "name": "reply-view",
      "description": "Draws Mermaid diagrams in Claude's replies as Unicode box art, makes file and folder paths open in Zed on Ctrl-click, and adds a /zed command.",
      "author": {
        "name": "Zhebil"
      },
      "homepage": "https://github.com/zhebil/claude-code-plugins/tree/main/plugins/reply-view",
      "repository": "https://github.com/zhebil/claude-code-plugins",
      "license": "MIT",
      "category": "productivity",
      "tags": [
        "mod",
        "mermaid",
        "diagrams",
        "terminal",
        "zed",
        "editor",
        "command",
        "links",
        "claude-code-plugin"
      ],
      "source": "./plugins/reply-view"
    },
    {
      "name": "fork-tab",
      "description": "Adds a /fork-new-tab command that forks the session into a new terminal tab (Warp, cmux or iTerm).",
      "author": {
        "name": "Zhebil"
      },
      "homepage": "https://github.com/zhebil/claude-code-plugins/tree/main/plugins/fork-tab",
      "repository": "https://github.com/zhebil/claude-code-plugins",
      "license": "MIT",
      "category": "productivity",
      "tags": [
        "mod",
        "warp",
        "cmux",
        "iterm",
        "fork",
        "session",
        "command",
        "claude-code-plugin"
      ],
      "source": "./plugins/fork-tab"
    },
    {
      "name": "defer-artifact",
      "description": "Puts the Artifact tool behind tool search, so its ~12k-token schema loads only in sessions that publish an artifact.",
      "author": {
        "name": "Zhebil"
      },
      "homepage": "https://github.com/zhebil/claude-code-plugins/tree/main/plugins/defer-artifact",
      "repository": "https://github.com/zhebil/claude-code-plugins",
      "license": "MIT",
      "category": "productivity",
      "tags": [
        "mod",
        "artifact",
        "context",
        "tokens",
        "tool-search",
        "deferred",
        "claude-code-plugin"
      ],
      "source": "./plugins/defer-artifact"
    }
  ]
}
